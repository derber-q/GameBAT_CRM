{
  "manifest_version": 3,
  "name": "ReSOURCE · Avito Check",
  "version": "1.6.4",
  "description": "Avito Check, создание продаж CRM из заказов и печать отправительных стикеров.",
  "permissions": ["storage", "debugger"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://192.168.0.131/*", "https://avito.ru/*", "https://www.avito.ru/*", "https://m.avito.ru/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/crm/sales/avito-extension/*", "http://localhost/crm/sales/avito-extension/*", "http://192.168.0.131/crm/sales/avito-extension/*"],
      "js": ["orders-crm.js"]
    },
    {
      "matches": ["https://avito.ru/*", "https://www.avito.ru/*", "https://m.avito.ru/*"],
      "css": ["orders.css"],
      "js": ["order-controls.js", "order-presentation.js", "orders.js"]
    },
    {
      "matches": ["http://127.0.0.1/crm/pricing/avito-check/*", "http://localhost/crm/pricing/avito-check/*", "http://192.168.0.131/crm/pricing/avito-check/*"],
      "js": ["protocol.js", "crm.js"]
    },
    {
      "matches": ["https://www.avito.ru/*", "https://avito.ru/*"],
      "css": ["cards.css"],
      "js": ["protocol.js", "cards.js", "panel.js"]
    }
  ]
}
